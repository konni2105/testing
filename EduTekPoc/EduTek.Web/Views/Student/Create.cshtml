@model EduTek.Web.Models.CreateStudentViewModel

@{
    ViewData["Title"] = "Create Student";
}

<h1>Create Student</h1>

<form asp-controller="Student" asp-action="Create" method="post">

    <div>
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" />
    </div>

    <br />

    <div>
        <label asp-for="LastName"></label>
        <input asp-for="LastName" />
    </div>

    <br />

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
    </div>

    <br />

    <div>
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" />
    </div>

    <br />

    <div>
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" type="date" />
    </div>

    <br />

    <div>
        <label asp-for="ClassId"></label>
        <input asp-for="ClassId" type="number" />
    </div>

    <br />

    <button type="submit">Create Student</button>

</form>

<br />

<a asp-controller="Student" asp-action="Index">
    Back to Students
</a>