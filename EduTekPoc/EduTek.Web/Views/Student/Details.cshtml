@model EduTek.Web.Models.StudentViewModel

@{
    ViewData["Title"] = "Student Details";
    var role = Context.Session.GetString("Role");
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Student Details</h1>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Student ID</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.StudentId</dd>

                    <dt class="col-sm-4 text-muted">First Name</dt>
                    <dd class="col-sm-8">@Model.FirstName</dd>

                    <dt class="col-sm-4 text-muted">Last Name</dt>
                    <dd class="col-sm-8">@Model.LastName</dd>

                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Phone Number</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>

                    <dt class="col-sm-4 text-muted">Date of Birth</dt>
                    <dd class="col-sm-8">@Model.DateOfBirth.ToString("dd-MM-yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Class ID</dt>
                    <dd class="col-sm-8">@Model.ClassId</dd>
                </dl>

                <div class="d-flex gap-2">
                    <a asp-controller="Student"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Back to Students
                    </a>

                    @if (role == "Admin")
                    {
                        <a asp-controller="Student"
                           asp-action="Edit"
                           asp-route-id="@Model.StudentId"
                           class="btn btn-warning">
                            Edit
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>