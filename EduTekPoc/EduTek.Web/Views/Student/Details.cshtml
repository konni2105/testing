@model EduTek.Web.Models.StudentViewModel

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">

    <h2>Student Details</h2>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">Student ID</dt>
        <dd class="col-sm-9">@Model.StudentId</dd>

        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone Number</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3">Date of Birth</dt>
        <dd class="col-sm-9">
            @Model.DateOfBirth.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">Class ID</dt>
        <dd class="col-sm-9">@Model.ClassId</dd>

    </dl>

    <a asp-controller="Student"
       asp-action="Edit"
       asp-route-id="@Model.StudentId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-controller="Student"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Students
    </a>

</div>