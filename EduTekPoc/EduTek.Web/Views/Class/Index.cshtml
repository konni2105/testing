@model List<EduTek.Web.Models.ClassViewModel>

@{
    ViewData["Title"] = "Classes";
    var role = Context.Session.GetString("Role");
}

<h1>Classes</h1>

@if (role == "Admin")
{
    <a asp-controller="Class" asp-action="Create">
        Create Class
    </a>
}

<br />
<br />

@if (Model != null && Model.Count > 0)
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Class ID</th>
                <th>Class Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClassId</td>
                    <td>@item.ClassName</td>
                    <td>@item.Description</td>

                    <td>

                        <a asp-controller="Class"
                           asp-action="Details"
                           asp-route-id="@item.ClassId">
                            Details
                        </a>

                        @if (role == "Admin")
                        {
                            <span> | </span>

                            <a asp-controller="Class"
                               asp-action="Edit"
                               asp-route-id="@item.ClassId">
                                Edit
                            </a>

                            <span> | </span>

                            <form asp-controller="Class"
                                  asp-action="Delete"
                                  asp-route-id="@item.ClassId"
                                  method="post"
                                  style="display:inline;">

                                <button type="submit">
                                    Delete
                                </button>

                            </form>
                        }

                    </td>
                </tr>
            }

        </tbody>

    </table>
}
else
{
    <p>No classes found.</p>
}