@model EduTek.Web.Models.ClassViewModel

@{
    ViewData["Title"] = "Class Details";
}

<h1>Class Details</h1>

<div>

    <p>
        <strong>Class ID:</strong>
        @Model.ClassId
    </p>

    <p>
        <strong>Class Name:</strong>
