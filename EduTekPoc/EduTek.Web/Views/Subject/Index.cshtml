@model List<EduTek.Web.Models.SubjectViewModel>

@{
    ViewData["Title"] = "Subjects";
    var role = Context.Session.GetString("Role");
}

<h1>Subjects</h1>

@if (role == "Admin")
{
    <a asp-controller="Subject"
       asp-action="Create">
        Create Subject
    </a>
}

<br />
<br />

@if (Model != null && Model.Count > 0)
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Subject ID</th>
                <th>Subject Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var subject in Model)
            {
                <tr>
                    <td>@subject.SubjectId</td>
                    <td>@subject.SubjectName</td>
                    <td>@subject.Description</td>

                    <td>
                        <a asp-controller="Subject"
                           asp-action="Details"
                           asp-route-id="@subject.SubjectId">
                            Details
                        </a>

                        @if (role == "Admin")
                        {
                            <span> | </span>

                            <a asp-controller="Subject"
                               asp-action="Edit"
                               asp-route-id="@subject.SubjectId">
                                Edit
                            </a>

                            <span> | </span>

                            <form asp-controller="Subject"
                                  asp-action="Delete"
                                  asp-route-id="@subject.SubjectId"
                                  method="post"
                                  style="display:inline;">

                                <button type="submit">
                                    Delete
                                </button>

                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>

    </table>
}
else
{
    <p>No subjects found.</p>
}