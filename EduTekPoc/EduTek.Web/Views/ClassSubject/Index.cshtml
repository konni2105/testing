@model List<EduTek.Web.Models.ClassSubjectViewModel>

@{
    ViewData["Title"] = "Class Subjects";
}

<h1>Class Subjects</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Assign Subject
    </a>
</p>

@if (Model != null && Model.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Class ID</th>
                <th>Class Name</th>
                <th>Subject ID</th>
                <th>Subject Name</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClassId</td>
                    <td>@item.ClassName</td>
                    <td>@item.SubjectId</td>
                    <td>@item.SubjectName</td>
                    <td>
                        <form asp-action="Delete"
                              method="post"
                              style="display:inline;">
                            <input type="hidden"
                                   name="classId"
                                   value="@item.ClassId" />

                            <input type="hidden"
                                   name="subjectId"
                                   value="@item.SubjectId" />

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No class-subject relationships found.</p>
}