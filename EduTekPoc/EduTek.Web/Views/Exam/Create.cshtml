@model EduTek.Web.Models.CreateExamViewModel

@{
    ViewData["Title"] = "Create Exam";
}

<h2>Create Exam</h2>

<form asp-controller="Exam"
      asp-action="Create"
      method="post">

    <div class="mb-3">
        <label asp-for="ExamName" class="form-label">
            Exam Name
        </label>

        <input asp-for="ExamName"
               class="form-control" />

        <span asp-validation-for="ExamName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SubjectId" class="form-label">
            Subject ID
        </label>

        <input asp-for="SubjectId"
               class="form-control" />

        <span asp-validation-for="SubjectId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ClassId" class="form-label">
            Class ID
        </label>

        <input asp-for="ClassId"
               class="form-control" />

        <span asp-validation-for="ClassId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ExamDate" class="form-label">
            Exam Date
        </label>

        <input asp-for="ExamDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="ExamDate"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Create Exam
    </button>

    <a asp-controller="Exam"
       asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}