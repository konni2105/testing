@model List<EduTek.Web.Models.ExamViewModel>

@{
    ViewData["Title"] = "Exams";

    var role = Context.Session.GetString("Role");
}

<h2>Exams</h2>

@if (role == "Admin" || role == "Teacher")
{
    <p>
        <a asp-controller="Exam"
           asp-action="Create"
           class="btn btn-primary">
            Create Exam
        </a>
    </p>
}

<table class="table table-bordered table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Exam ID</th>
            <th>Exam Name</th>
            <th>Subject</th>
            <th>Class</th>
            <th>Exam Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var exam in Model)
            {
                <tr>
                    <td>@exam.ExamId</td>

                    <td>@exam.ExamName</td>

                    <td>
                        @exam.SubjectName
                    </td>

                    <td>
                        @exam.ClassName
                    </td>

                    <td>
                        @exam.ExamDate.ToString("dd-MM-yyyy")
                    </td>

                    <td>
                        <a asp-controller="Exam"
                           asp-action="Details"
                           asp-route-id="@exam.ExamId"
                           class="btn btn-info">
                            Details
                        </a>

                        @if (role == "Admin" || role == "Teacher")
                        {
                            <a asp-controller="Exam"
                               asp-action="Edit"
                               asp-route-id="@exam.ExamId"
                               class="btn btn-warning">
                                Edit
                            </a>

                            <form asp-controller="Exam"
                                  asp-action="Delete"
                                  asp-route-id="@exam.ExamId"
                                  method="post"
                                  style="display:inline;">

                                <button type="submit"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this exam?');">
                                    Delete
                                </button>

                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">
                    No exams found.
                </td>
            </tr>
        }
    </tbody>
</table>