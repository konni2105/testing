@model EduTek.Web.Models.CreateMarkViewModel

@{
    ViewData["Title"] = "Add Mark";
}

<h2>Add Mark</h2>

<form asp-controller="Mark"
      asp-action="Create"
      method="post">

    <div class="mb-3">
        <label asp-for="ExamId" class="form-label">
            Exam ID
        </label>

        <input asp-for="ExamId"
               class="form-control" />

        <span asp-validation-for="ExamId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StudentId" class="form-label">
            Student ID
        </label>

        <input asp-for="StudentId"
               class="form-control" />

        <span asp-validation-for="StudentId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Score" class="form-label">
            Score
        </label>

        <input asp-for="Score"
               type="number"
               step="0.01"
               min="0"
               max="100"
               class="form-control" />

        <span asp-validation-for="Score"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Add Mark
    </button>

    <a asp-controller="Mark"
       asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}