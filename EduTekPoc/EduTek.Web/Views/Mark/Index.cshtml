@model List<EduTek.Web.Models.MarkViewModel>

@{
    ViewData["Title"] = "Marks";

    var role = Context.Session.GetString("Role");
}

<h2>Marks</h2>

@if (role == "Admin" || role == "Teacher")
{
    <p>
        <a asp-controller="Mark"
           asp-action="Create"
           class="btn btn-primary">
            Add Mark
        </a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Mark ID</th>
            <th>Exam</th>
            <th>Student</th>
            <th>Score</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var mark in Model)
            {
                <tr>
                    <td>@mark.MarkId</td>

                    <td>
                        @mark.ExamName
                    </td>

                    <td>
                        @mark.StudentName
                    </td>

                    <td>
                        @mark.Score
                    </td>

                    <td>
                        <a asp-controller="Mark"
                           asp-action="Details"
                           asp-route-id="@mark.MarkId"
                           class="btn btn-info">
                            Details
                        </a>

                        @if (role == "Admin" || role == "Teacher")
                        {
                            <a asp-controller="Mark"
                               asp-action="Edit"
                               asp-route-id="@mark.MarkId"
                               class="btn btn-warning">
                                Edit
                            </a>
                        }

                        @if (role == "Admin")
                        {
                            <form asp-controller="Mark"
                                  asp-action="Delete"
                                  asp-route-id="@mark.MarkId"
                                  method="post"
                                  style="display:inline;">

                                <button type="submit"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this mark?');">
                                    Delete
                                </button>

                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">
                    No marks found.
                </td>
            </tr>
        }
    </tbody>
</table>