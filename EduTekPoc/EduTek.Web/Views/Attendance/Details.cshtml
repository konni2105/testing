@model EduTek.Web.Models.AttendanceViewModel

@{
    ViewData["Title"] = "Attendance Details";
}

<h2>Attendance Details</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Attendance Details</h1>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Attendance ID</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.AttendanceId</dd>

                    <dt class="col-sm-4 text-muted">Student ID</dt>
                    <dd class="col-sm-8">@Model.StudentId</dd>

                    <dt class="col-sm-4 text-muted">Student Name</dt>
                    <dd class="col-sm-8">@Model.StudentName</dd>

                    <dt class="col-sm-4 text-muted">Subject ID</dt>
                    <dd class="col-sm-8">@Model.SubjectId</dd>

                    <dt class="col-sm-4 text-muted">Subject Name</dt>
                    <dd class="col-sm-8">@Model.SubjectName</dd>

                    <dt class="col-sm-4 text-muted">Attendance Date</dt>
                    <dd class="col-sm-8">@Model.AttendanceDate.ToString("dd-MM-yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsPresent)
                        {
                            <span class="badge bg-success">Present</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Absent</span>
                        }
                    </dd>
                </dl>

                <div class="d-flex gap-2">
                    <a asp-controller="Attendance"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                    @{
                        var role = Context.Session.GetString("Role");
                    }

                    @if (role == "Admin" || role == "Teacher")
                    {
                        <a asp-controller="Attendance"
                           asp-action="Edit"
                           asp-route-id="@Model.AttendanceId"
                           class="btn btn-warning">
                            Edit
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>