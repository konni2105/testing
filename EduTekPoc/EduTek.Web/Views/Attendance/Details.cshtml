@model EduTek.Web.Models.AttendanceViewModel

@{
    ViewData["Title"] = "Attendance Details";
}

<h2>Attendance Details</h2>

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Attendance ID
        </dt>
        <dd class="col-sm-9">
            @Model.AttendanceId
        </dd>

        <dt class="col-sm-3">
            Student ID
        </dt>
        <dd class="col-sm-9">
            @Model.StudentId
        </dd>

        <dt class="col-sm-3">
            Student Name
        </dt>
        <dd class="col-sm-9">
            @Model.StudentName
        </dd>

        <dt class="col-sm-3">
            Subject ID
        </dt>
        <dd class="col-sm-9">
            @Model.SubjectId
        </dd>

        <dt class="col-sm-3">
            Subject Name
        </dt>
        <dd class="col-sm-9">
            @Model.SubjectName
        </dd>

        <dt class="col-sm-3">
            Attendance Date
        </dt>
        <dd class="col-sm-9">
            @Model.AttendanceDate.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>
        <dd class="col-sm-9">
            @if (Model.IsPresent)
            {
                <span>Present</span>
            }
            else
            {
                <span>Absent</span>
            }
        </dd>

    </dl>
</div>

<div>
    <a asp-controller="Attendance"
       asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

    @{
        var role = Context.Session.GetString("Role");
    }

    @if (role == "Admin" || role == "Teacher")
    {
        <a asp-controller="Attendance"
           asp-action="Edit"
           asp-route-id="@Model.AttendanceId"
           class="btn btn-warning">
            Edit
        </a>
    }
</div>